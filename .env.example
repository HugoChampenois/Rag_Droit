# =====================================================================
# Variables d'environnement du pipeline RAG Droit
# ---------------------------------------------------------------------
# Copiez ce fichier vers `.env` puis renseignez les valeurs :
#     cp .env.example .env
# Le fichier `.env` n'est JAMAIS versionné (voir .gitignore).
# =====================================================================

# --- Serveur d'embedding "bulk" (modèle bge-m3, GPU distant, vLLM) ---
# URL du serveur vLLM exposant une API OpenAI-compatible (/v1/embeddings).
# Remplacez par l'adresse de votre serveur.
OLLAMA_BULK_URL=http://localhost:8000

# Backend utilisé pour l'embedding bulk : "openai" (vLLM) ou "ollama".
RAG_BULK_BACKEND=openai

# --- Serveur d'embedding "mise à jour / recherche" (Ollama, CPU local) ---
OLLAMA_UPDATE_URL=http://localhost:11434
RAG_UPDATE_BACKEND=ollama

# --- Clé API du backend OpenAI/vLLM (en-tête Authorization: Bearer ...) ---
# Laissez vide si votre serveur d'embedding n'exige pas d'authentification.
RAG_EMBED_API_KEY=

# --- Modèle d'embedding ---
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_DIM=1024

# --- Base vectorielle Qdrant ---
QDRANT_URL=http://localhost:6333
RAG_COLLECTION=rag_droit

# --- Chemin racine du projet (facultatif) ---
# Par défaut le code suppose /opt/rag ; surchargez-le si vous installez ailleurs.
# RAG_BASE_DIR=/opt/rag
